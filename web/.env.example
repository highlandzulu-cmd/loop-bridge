# Copy to .env (gitignored) and edit. Vite only exposes vars prefixed
# VITE_ to client code — see src/main.ts.

# Where the loop-server bridge is reachable from the browser. Defaults to
# http://127.0.0.1:8787 (same machine, default port) if left unset — only
# needed here if the bridge runs elsewhere. See ../bridge/README.md for
# the matching LOOP_SERVER_CORS_ORIGIN setting the bridge needs pointed
# back at wherever this app is served from.
# VITE_LOOP_SERVER_URL=http://127.0.0.1:8787
