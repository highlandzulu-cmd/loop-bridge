# Copy this file to `.env` (in the repo root, same directory as this file)
# and edit it — `.env` itself is gitignored, this example isn't.
#
# loop-server reads this on startup (see crates/loop-server/src/main.rs,
# load_dotenv()). Every var here is optional; sensible defaults are noted
# below. Anything already set as a real shell env var wins over the file.

# --- Which model loop-server talks to -------------------------------------
#
# Leave both unset to use whatever's already configured in
# ~/.loop/agent/settings.json (Soket by default — needs SOKET_API_KEY /
# TENSORSTUDIO_API_KEY / LOOP_API_KEY set).
#
# To point at a free local model instead:
#   1. Install Ollama (https://ollama.com) and pull a model, e.g.:
#        ollama pull qwen2.5:1.5b-instruct
#   2. Register it as a custom provider in ~/.loop/agent/models.json:
#        {
#          "providers": [{
#            "id": "ollama",
#            "name": "Ollama (local)",
#            "baseUrl": "http://localhost:11434/v1",
#            "apiKeyEnv": [],
#            "models": ["qwen2.5:1.5b-instruct"]
#          }]
#        }
#      (Note the path: ~/.loop/agent/models.json, NOT ~/.loop/models.json —
#      easy to get wrong, and it fails silently by falling back to Soket
#      instead of erroring. See crates/loop-server/README.md.)
#   3. Set these two:
#
# LOOP_SERVER_PROVIDER=ollama
# LOOP_SERVER_MODEL=qwen2.5:1.5b-instruct
#
# Model notes from testing: llama3.2:1b handles plain chat fine but breaks
# on tool-calling (hallucinates malformed tool calls). qwen2.5:1.5b-instruct
# correctly handles both plain chat and real tool execution — use that one.

# --- Session persistence ---------------------------------------------------
# Where loop-server remembers the session id across restarts, so
# conversation history survives a server restart. Relative to whatever
# directory you launch loop-server from.
# LOOP_SERVER_SESSION_FILE=.loop-server-session-id

# --- Networking -------------------------------------------------------------
# LOOP_SERVER_PORT=8787
#
# Origin the browser frontend is served from. Must match the web/ dev
# server's actual origin or the browser will block requests with a CORS
# error. Only relax this to "*" for a throwaway local demo, never anywhere
# it might be reachable by anyone else.
# LOOP_SERVER_CORS_ORIGIN=http://localhost:5173

# --- Testing without a real model -------------------------------------------
# Set to "1" to use Loop's built-in scripted/faux provider instead of a
# real model — useful for testing the bridge and frontend wiring itself
# without needing Ollama or a paid API key up.
# LOOP_SERVER_FAUX=0

# --- RAG tool (see crates/loop-server/README.md "Tools") --------------------
# The model has a real rag_query tool it can call to retrieve context from an
# external RAG/knowledge-base service. Unset by default — when unset, the
# tool honestly tells the model no RAG service is configured rather than
# fabricating results. Set this to a real service's base URL to enable it;
# the tool POSTs {"query": "..."} to "{RAG_SERVICE_URL}/query" and expects a
# JSON response back — see cloudflare-rag/README.md for a real, deployable
# test-stub RAG service (Cloudflare Workers AI + Vectorize, zero local
# compute) that matches this shape; RAG_SERVICE_API_KEY is sent as
# `Authorization: Bearer <key>` if set (that Worker requires it — it's a
# public URL). Point at a different RAG service and this shape is a
# placeholder convention, not a fixed spec — adjust build_rag_query_tool()
# in crates/loop-server/src/main.rs to match its real API.
#
# Note: this is separate from the frontend's RAG sidebar card (web/) — that
# toggle is currently just browser-side UI state, not wired to this variable
# or to this tool at all. See web/README.md "RAG connection".
# RAG_SERVICE_URL=https://loop-rag-worker.<your-subdomain>.workers.dev
# RAG_SERVICE_API_KEY=
